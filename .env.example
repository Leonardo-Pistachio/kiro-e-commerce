# Copy to .env and fill in. .env is gitignored; never commit real values.

# Optional: Amazon Bedrock API key (bearer token). Leave empty to use the
# built-in rule-based shopping assistant.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
# Optional: Bedrock model or inference profile id (default us.amazon.nova-lite-v1:0)
BEDROCK_MODEL_ID=

# Optional overrides
PORT=
DB_PATH=
ORDER_SHIP_SECONDS=
ORDER_DELIVER_SECONDS=
